DSM_TAORAN_ENVIRONMENT=development
DSM_TAORAN_DATABASE_PATH=data/taoran_agent.db
# 客户接入管理页：默认关闭。生产启用时必须使用单独高强度Key。
DSM_TAORAN_ADMIN_ENABLED=false
DSM_TAORAN_ADMIN_API_KEY=
DSM_TAORAN_ADMIN_AUDIT_PATH=data/tenant_admin_audit.jsonl
# 多客户生产配置：复制示例到服务器受控runtime目录，填入真实值并设置文件权限600。
# 配置后优先使用租户注册表；下面三个旧变量仅作为现有tenant_demo的兼容回退。
DSM_TAORAN_TENANT_REGISTRY_PATH=
DSM_TAORAN_TENANT_REGISTRY_JSON={"version":1,"tenants":{}}
DSM_TAORAN_TENANT_KEYS_JSON={"tenant_demo":"replace-me"}
DSM_TAORAN_JIANDAOYUN_API_KEYS_JSON={"tenant_demo":"replace-with-jiandaoyun-api-key"}
DSM_TAORAN_JIANDAOYUN_BASE_URL=https://api.jiandaoyun.com/api
DSM_TAORAN_JIANDAOYUN_TIMEOUT_SECONDS=10
DSM_TAORAN_SEMANTIC_ENDPOINT=
DSM_TAORAN_SEMANTIC_API_KEY=
DSM_TAORAN_SEMANTIC_TIMEOUT_SECONDS=6
DSM_TAORAN_PRECHECK_BUDGET_SECONDS=12
# 直接大模型接入：默认关闭。独立配置，不读取40题的AI_SCORING_*，勿复用知识库/简道云Key。
DSM_TAORAN_LLM_ENABLED=false
DSM_TAORAN_LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
DSM_TAORAN_LLM_MODEL=glm-5.2
DSM_TAORAN_LLM_API_KEY=
# 提交前固定为本地规则，不调用大模型；以下是提交后总预算（含一次格式重试）。
DSM_TAORAN_LLM_EVALUATION_TIMEOUT_SECONDS=45
DSM_TAORAN_LLM_FORMAT_RETRIES=1
DSM_TAORAN_LLM_MAX_CONCURRENCY=2
DSM_TAORAN_LLM_MAX_INPUT_CHARS=24000
DSM_TAORAN_LLM_MAX_OUTPUT_TOKENS=3000
# 知识API Key仅用于人工/定时同步；前端AI检测只读本地已审核快照。
DSM_TAORAN_KNOWLEDGE_API_BASE_URL=https://knowledge.api.yudaozhijian.top
DSM_TAORAN_KNOWLEDGE_API_KEY=
DSM_TAORAN_KNOWLEDGE_TIMEOUT_SECONDS=10
DSM_TAORAN_KNOWLEDGE_SNAPSHOT_PATH=
DSM_TAORAN_JIANDAOYUN_MAPPING_PATH=config/jiandaoyun_field_mapping.example.json
# Q40预留接口默认关闭；未启用时不会影响现有40题或TAORAN流程。
DSM_TAORAN_ENABLE_Q40_INTEGRATION=false
DSM_TAORAN_Q40_SERVICE_ID=dsm-q40-agent
DSM_TAORAN_Q40_SERVICE_KEYS_JSON={"tenant_demo":"replace-with-dedicated-q40-service-key"}
# 生产共享存储预留；为空时继续使用现有SQLite，不发生存储切换。
DSM_TAORAN_SHARED_STORE_URL=
