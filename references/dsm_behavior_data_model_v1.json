  "quality_rules": [
    {"code": "DQ-001", "rule": "任何跨表关联必须优先使用编号，不得仅凭人员名、团队名或客户名连接。"},
    {"code": "DQ-002", "rule": "统一ID由平台生成；外部编号与来源系统、来源表共同构成可追溯业务键。"},
    {"code": "DQ-003", "rule": "计划快照、客户分类、联系人关系和商机状态均带有效时间，历史记录不可覆盖。"},
    {"code": "DQ-004", "rule": "月报和日报中的汇总数字属于派生快照；存在明细事实时必须从明细复算并记录差异。"},
    {"code": "DQ-005", "rule": "Excel日期序列转换为带时区日期/时间，同时保留原始值和来源单元格。"},
    {"code": "DQ-006", "rule": "设备编码在租户内应唯一；重复编码进入冲突队列，不自动合并客户设备。"},
    {"code": "DQ-007", "rule": "商机产品、决策联系人和友商信息从宽表拆为子实体，空白续行只继承明确的父商机来源记录。"},
    {"code": "DQ-008", "rule": "附件只保存受控对象引用和内容哈希，评价证据不得依赖不可访问的本地文件名。"},
    {"code": "DQ-009", "rule": "数据不足、无记录和业务零值分别表达，禁止将空值直接改写为0。"},
    {"code": "DQ-010", "rule": "所有租户级标准必须版本化并具备生效区间；评分结果锁定使用的策略版本。"},
    {"code": "DQ-011", "rule": "销售代表工作日报中的“当日项目会议总数”和“当日标书/建议书总数”为停用字段，不得采集、派生或参与Q40评分统计。"},
    {"code": "DQ-012", "rule": "Q01综合拜访数量按拜访记录逐条使用生效折算策略计算1÷折算数量比例；来源记录中的折算比例和折算后数量仅用于对账，差异必须保留为数据质量证据。"},
    {"code": "DQ-013", "rule": "Q02拜访结束时间优先使用来源记录的实际结束时间；缺失时用实际开始时间加拜访时长补算。两者同时存在但不一致时保留原始结束时间并记录差异。"}
  ],
