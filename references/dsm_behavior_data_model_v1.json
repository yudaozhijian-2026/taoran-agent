{
  "schema_version": "1.0.0",
  "model_code": "DSM-BEHAVIOR-DATA-MODEL",
  "model_version": "V1",
  "name": "DSM统一行为数据模型V1",
  "status": "confirmed_baseline",
  "confirmed_on": "2026-08-07",
  "source_catalog": "saas_source_field_catalog_v1.json",
  "scope": {
    "source_workbooks": 26,
    "source_fields": 604,
    "modeling_statement": "确认统一实体、关系、时间语义、来源追溯和分层原则；源系统中语义不明确的字段保留原值并进入待确认清单，不做静默改写。",
    "retired_source_fields": [
      {
        "source_file": "销售代表工作日报.xlsx",
        "source_headers": ["当日项目会议总数", "当日标书/建议书总数"],
        "effective_on": "2026-08-07",
        "handling": "从SaaS基础数据基线及源字段目录删除，不进入统一事实、派生指标或Q40评分统计。"
      }
    ]
  },
  "layers": [
    {
      "code": "source",
      "name": "来源层",
      "rule": "逐条保存外部记录、原始字段、附件定位、来源时间和内容哈希；不在此层修改业务事实。"
    },
    {
      "code": "canonical",
      "name": "统一事实层",
      "rule": "使用稳定ID、明确主外键和有效期表达组织、客户、联系人、活动、商机及配置事实。"
    },
    {
      "code": "derived",
      "name": "派生指标层",
      "rule": "日均量、覆盖率、完成率、月报和团队汇总均由统一事实及版本化口径计算，保存计算窗口和输入快照。"
    },
    {
      "code": "evaluation",
      "name": "评价结果层",
      "rule": "Q01-Q40得分、证据、规则版本、数据质量状态和AI解释相互分离，正式结果不可原地覆盖。"
    }
  ],
  "global_fields": [
    "id",
    "tenant_id",
    "source_system",
    "source_table",
    "source_record_id",
    "source_record_hash",
    "source_observed_at",
    "valid_from",
    "valid_to",
    "created_at",
    "updated_at"
  ],
  "domains": [
    {
      "code": "organization",
